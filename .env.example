# ---------- LLM (any OpenAI-compatible endpoint) ----------
# Offline demo (default): the bundled mock scorer — no key needed.
LLM_BASE_URL=http://127.0.0.1:8787/llm/v1
LLM_API_KEY=mock-key
LLM_MODEL=mock-llm-offline
# Real examples:
#   OpenAI:     LLM_BASE_URL=https://api.openai.com/v1                     LLM_MODEL=gpt-4o-mini
#   Anthropic:  LLM_BASE_URL=https://api.anthropic.com/v1                  LLM_MODEL=claude-sonnet-4-5
#   Bedrock:    LLM_BASE_URL=https://bedrock-runtime.<region>.amazonaws.com/openai/v1   LLM_MODEL=<model id>
LLM_MAX_TOKENS=1200
# USD per 1M tokens — used for the per-lead cost column (set to your model's prices)
LLM_PRICE_INPUT_PER_M=0.60
LLM_PRICE_OUTPUT_PER_M=2.50
HOT_THRESHOLD=70

# ---------- CRM target: hubspot | airtable | sheets ----------
CRM_TARGET=hubspot
HUBSPOT_BASE_URL=http://127.0.0.1:8787/hubspot          # real: https://api.hubapi.com
HUBSPOT_TOKEN=mock-hubspot-token                        # HubSpot private app token (crm.objects.contacts.write)
AIRTABLE_BASE_URL=http://127.0.0.1:8787/airtable        # real: https://api.airtable.com
AIRTABLE_TOKEN=mock-airtable-token                      # Airtable personal access token (data.records:write)
AIRTABLE_BASE_ID=appDemoBase123
AIRTABLE_TABLE=Leads
SHEETS_WEBHOOK_URL=http://127.0.0.1:8787/sheets/exec    # real: your Apps Script web app URL (apps-script/Code.gs)
SHEETS_WEBHOOK_TOKEN=change-me-shared-secret

# ---------- Notifications ----------
TELEGRAM_API_BASE=http://127.0.0.1:8787/telegram        # real: https://api.telegram.org
TELEGRAM_BOT_TOKEN=123456:mock-bot-token
TELEGRAM_CHAT_ID=-1001234567890
EMAIL_API_URL=http://127.0.0.1:8787/email/emails        # real: https://api.resend.com/emails (or any Resend-compatible API)
EMAIL_API_KEY=mock-email-key
EMAIL_FROM="Lead Bot <alerts@example.com>"
SALES_EMAIL=sales@example.com
# Error workflow log target (defaults to SHEETS_WEBHOOK_URL, sheet "Errors")
ERROR_LOG_URL=http://127.0.0.1:8787/sheets/exec

# ---------- n8n ----------
N8N_PORT=5678
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
GENERIC_TIMEZONE=UTC
